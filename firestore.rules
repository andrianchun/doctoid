rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keamanan Ketat Doctoid: Akses hanya diizinkan untuk pemilik akun yang terotentikasi
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Zero-knowledge encrypted sync: wajib login Google, dilarang list/scraping dan dilarang hapus
    match /doctoid/{syncId} {
      allow get, create, update: if request.auth != null;
      allow list, delete: if false;
    }

    // Blokir semua koleksi lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
