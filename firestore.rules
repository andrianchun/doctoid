rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keamanan Ketat Doctoid: Akses hanya diizinkan untuk pemilik akun yang terotentikasi
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /doctoid/{syncId} {
      allow read, write: if request.auth != null;
    }
    
    // Blokir semua koleksi lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
