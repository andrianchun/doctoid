{
  "appId": "com.andrianchun.doctoid",
  "appName": "Doctoid",
  "webDir": "dist",
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "LIGHT"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com"]
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_doctoid",
      "iconColor": "#0D9488"
    },
    "CapacitorUpdater": {
      "autoUpdate": false
    }
  }
}
